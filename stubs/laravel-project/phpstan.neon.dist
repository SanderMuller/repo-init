includes:
    - phpstan-baseline.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon
    # Writes the named-argument manifest (namedArgumentManifest below).
    # phpstan/extension-installer does not load this file.
    - vendor/hihaho/phpstan-rules/named-argument-manifest.neon

rules:
    # Hand-picked symplify/phpstan-rules rules (its rule sets are off, see
    # parameters.symplify). The list is hihaho/phpstan.neon's.
    - Symplify\PHPStanRules\Rules\StringFileAbsolutePathExistsRule
    - Symplify\PHPStanRules\Rules\Complexity\NoArrayMapWithArrayCallableRule
    - Symplify\PHPStanRules\Rules\Complexity\ForbiddenArrayMethodCallRule
    - Symplify\PHPStanRules\Rules\ForbiddenMultipleClassLikeInOneFileRule
    - Symplify\PHPStanRules\Rules\NoDynamicNameRule
    - Symplify\PHPStanRules\Rules\NoGlobalConstRule
    - Symplify\PHPStanRules\Rules\PreventParentMethodVisibilityOverrideRule
    - Symplify\PHPStanRules\Rules\Enum\RequireUniqueEnumConstantRule
    - Symplify\PHPStanRules\Rules\UppercaseConstantRule
    - Symplify\PHPStanRules\Rules\PHPUnit\PublicStaticDataProviderRule
    - Symplify\PHPStanRules\Rules\Explicit\NoMissingVariableDimFetchRule

parameters:
    tmpDir: .cache/phpstan

    # symplify/phpstan-rules turns these rule sets on by default.
    symplify:
        naming: false
        complexity: false
        configurable: false
        static: false
        modern: false
        symfony: false
        symfonyConfig: false
        doctrine: false
        collections: false
        phpunit: false

    paths:
        - app
        - routes
        - config
        - database
        - tests

    level: max

    strictRules:
        allRules: true

    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 100

    type_perfect:
        null_over_false: true
        narrow_return: true
        narrow_param: true

    cognitive_complexity:
        class: 80
        function: 20

    # larastan parameters. Both hihaho/phpstan.neon and mijntp/phpstan.neon set these
    # four; they exist only when larastan is installed, so they stay out of the package
    # categories.
    noEnvCallsOutsideOfConfig: true
    checkModelProperties: true
    checkModelAppends: true
    checkOctaneCompatibility: false

    # Lets larastan read config() types from config/*.php instead of mixed. A
    # config()->set() in a test does not change the type.
    checkConfigTypes: true

    # hihaho/phpstan-rules (phpstan/extension-installer loads it). These rules do
    # nothing until a project names its namespaces, providers and route files.
    # A value that reaches a raw-HTML sink must be escaped, Htmlable, or ignored
    # with a reason.
    unescapedHtml:
        namespaces:
            - App

    # A broad catch that neither rethrows, reports nor reads what it caught hides
    # every failure.
    swallowedException:
        namespaces:
            - App

    # Types $this->route('x') from the Route::model() and Route::bind() calls in
    # these providers.
    routeBindingProviders:
        - App\Providers\AppServiceProvider

    # Types $this->route('x') from the controller type-hints in these route files
    # (implicit bindings). Add each route file the app loads.
    routeFiles:
        - routes/web.php

    # Writes the manifest that hihaho/rector-rules' NamedArgumentFromManifestRector
    # reads (see rector.php). Run PHPStan before Rector to refresh it, and commit it.
    namedArgumentManifest:
        firstPartyNamespaces:
            - App
            - Database\Factories
            - Tests
        outputPath: .config/named-arguments-manifest.json

    # Off at every level, and phpstan-strict-rules does not set them.
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkTooWideParameterOutInProtectedAndPublicMethods: true
    checkTooWideThrowTypesInProtectedAndPublicMethods: true
    reportAlwaysTrueInLastCondition: true
    reportAnyTypeWideningInVarTag: true

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        -
            identifier: trait.unused
            reportUnmatched: false
        # Pest's expectation API is marked @internal but is the intended public
        # surface for tests. Allow calling it from our tests/.
        -
            identifier: method.internalClass
            paths:
                - tests/*
            reportUnmatched: false
        # NoDynamicNameRule (registered above) fires on the dynamic dispatch test
        # helpers use. hihaho/phpstan.neon scopes the same identifier out of tests/.
        -
            identifier: symplify.noDynamicName
            paths:
                - tests/*
            reportUnmatched: false
        # A test may assert a value PHPStan already knows, such as the skeleton's
        # assertTrue(true). hihaho/phpstan.neon scopes the static-call identifier out
        # of tests/. The Laravel 13 skeleton calls $this->assertTrue(), so the
        # instance-call identifier needs the same scope.
        -
            identifier: staticMethod.alreadyNarrowedType
            paths:
                - tests/*
            reportUnmatched: false
        -
            identifier: method.alreadyNarrowedType
            paths:
                - tests/*
            reportUnmatched: false

    # Derived state — analysing it yields noise, not findings. Both reference apps
    # exclude the same two.
    excludePaths:
        - bootstrap/cache
        - .cache
