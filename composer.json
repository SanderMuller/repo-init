{
    "name": "sandermuller/repo-init",
    "type": "library",
    "description": "AI playbook + stub library for bootstrapping the canonical Sander/hihaho repo setup. Install globally: `composer global require sandermuller/repo-init`.",
    "keywords": [
        "ai",
        "scaffold",
        "bootstrap",
        "laravel",
        "php-package",
        "phpstan-extension",
        "rector-extension",
        "package-boost"
    ],
    "homepage": "https://github.com/sandermuller/repo-init",
    "license": "MIT",
    "authors": [
        {
            "name": "Sander Muller",
            "email": "github@scode.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "sandermuller/package-boost": "^0.15",
        "orchestra/testbench": "^9.0||^10.0||^11.0"
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"if (file_exists('vendor/bin/testbench')) { passthru('vendor/bin/testbench package-boost:sync --scope=user 2>/dev/null || true'); }\""
        ],
        "post-update-cmd": [
            "@php -r \"if (file_exists('vendor/bin/testbench')) { passthru('vendor/bin/testbench package-boost:sync --scope=user 2>/dev/null || true'); }\""
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
