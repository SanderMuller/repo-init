{
    "name": "sandermuller/repo-init",
    "type": "library",
    "description": "AI playbook + stub library for bootstrapping the canonical Sander/hihaho repo setup. Install globally: `composer global require sandermuller/repo-init`.",
    "keywords": [
        "ai",
        "scaffold",
        "bootstrap",
        "laravel",
        "php-package",
        "phpstan-extension",
        "rector-extension"
    ],
    "homepage": "https://github.com/sandermuller/repo-init",
    "license": "MIT",
    "authors": [
        {
            "name": "Sander Muller",
            "email": "github@scode.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "sandermuller/package-boost-php": "^0.5.0",
        "orchestra/testbench": "^10.0||^11.0"
    },
    "require-dev": {
        "laravel/pao": "^1.0",
        "nunomaduro/collision": "^8.0",
        "sandermuller/boost-skills": "^1.0"
    },
    "scripts": {
        "post-install-cmd": [
            "SanderMuller\\BoostCore\\Scripts\\BoostAutoSync::runWithSummary"
        ],
        "post-update-cmd": [
            "SanderMuller\\BoostCore\\Scripts\\BoostAutoSync::runWithSummary"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "sandermuller/boost-core": true,
            "sandermuller/package-boost-php": true
        }
    }
}
